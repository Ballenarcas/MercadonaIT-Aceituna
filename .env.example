# Copia este archivo como .env y rellena tus valores:
#   cp .env.example .env   (el backend lo carga automáticamente)
# ── Backend (FastAPI) ─────────────────────────────────────────────
# Clave de GroqCloud (obligatoria para el chatbot AceitunAI).
# Consíguela en https://console.groq.com → API Keys
GROQ_API_KEY=gsk_tu_clave_aqui

# Modelo de Groq a usar (opcional, este es el valor por defecto)
GROQ_MODEL=llama-3.3-70b-versatile

# URL de la base de datos SQLite (opcional)
DATABASE_URL=sqlite:///./mercadona.db

# ── Frontend (Vite) ─────────────────────────────────────────────
# URL base de la API que usa el frontend (opcional)
VITE_API_URL=http://localhost:8000/api
